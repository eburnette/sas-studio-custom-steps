: 64,\n\t\t\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"secSimMethod\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Simulation Method\",\n\t\t\t\t\t\"open\": false,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"SimMethod\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Method:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"automatic\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Automatic (recommended -- selects best based on qubit count)\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"statevector\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Statevector (exact; memory-intensive; good for up to ~20 qubits)\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"mps\",\n\t\t\t\t\t\t\t\t\t\"label\": \"MPS / tensor-network (handles larger circuits approximately)\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"qasm\",\n\t\t\t\t\t\t\t\t\t\"label\": \"QASM shot-based (noisy simulation; pair with a noise model)\"\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\t\t\"quantumlab\"\n\t\t\t\t\t\t\t],\n\t\t\t\t\t\t\t\"width\": \"520px\",\n\t\t\t\t\t\t\t\"style\": {\n\t\t\t\t\t\t\t\t\"width\": \"520px\"\n\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\"required\": true\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"SimMethodAutoQX\",\n\t\t\t\t\t\t\t\"type\": \"dropdown\",\n\t\t\t\t\t\t\t\"label\": \"Method for optimization demo baseline:\",\n\t\t\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"automatic\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Automatic (recommended -- selects best based on qubit count)\"\n\t\t\t\t\t\t\t\t},\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\"value\": \"statevector\",\n\t\t\t\t\t\t\t\t\t\"label\": \"Statevector (