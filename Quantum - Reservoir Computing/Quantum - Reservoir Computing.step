t\t\t\t\"label\": \"Hypertune (optimize quantum circuit parameters)\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"section1\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Output\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": \"\",\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"outputDS\",\n\t\t\t\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\t\t\t\"label\": \"Save output data\",\n\t\t\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"outputtable1\",\n\t\t\t\t\t\t\t\"type\": \"outputtable\",\n\t\t\t\t\t\t\t\"label\": \"Output table (QRC-transformed data):\",\n\t\t\t\t\t\t\t\"required\": false,\n\t\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\t\"visible\": \"$outputDS\",\n\t\t\t\t\t\t\t\"indent\": 1\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"text5\",\n\t\t\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\t\t\"text\": \"Note: When running this step in a flow, you must add an output port for this optional table on the step node.\",\n\t\t\t\t\t\t\t\"visible\": \"$outputDS\",\n\t\t\t\t\t\t\t\"indent\": 1\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"replaceOutput\",\n\t\t\t\t\t\t\t\"type\": \"checkbox\",\n\t\t\t\t\t\t\t\"label\": \"Replace existing output table\",\n\t\t\t\t\t\t\t\"visible\": \"$outputDS\",\n\t\t\t\t\t\t\t\"indent\": 1\n\t\t\t\t\t\t}\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"id\": \"pageQRC\",\n\t\t\t\"type\": \"page\",\n\t\t\t\"label\": \"QRC Options\",\n\t\t\t\"children\": [\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"CircuitType\",\n\t\t\t\t\t\"type\": \"radiogroup\",\n\t\t\t\t\t\"label\": \"Circuit type:\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"LINEAR\",\n\t\t\t\t\t\t\t\"label\": \"Linear\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"ENTANGLED\",\n\t\t\t\t\t\t\t\"label\": \"Entangled\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"NONLINEAR\",\n\t\t\t\t\t\t\t\"label\": \"Nonlinear\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"RECURRENTFEEDBACK\",\n\t\t\t\t\t\t\t\"label\": \"Recurrent feedback\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"PARAMETRIC\",\n\t\t\t\t\t\t\t\"label\": \"Parametric\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"SPARSECONNECTIVITY\",\n\t\t\t\t\t\t\t\"label\": \"Sparse connectivity\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"quantumlab\"\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"list1\",\n\t\t\t\t\t\"type\": \"list\",\n\t\t\t\t\t\"label\": \"Optimization demo circuit types:\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Linear\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Entangled\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Nonlinear\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Recurrent feedback\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Parametric\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"Sparse connectivity\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"max\": null,\n\t\t\t\t\t\"min\": null,\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"autotune\"\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"txtCircuitAutoQX\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Optimization mode uses PROC HYPERTUNE to search the selected qubit range and SVM parameters on a log scale, uses the cache when enabled, and renders the champion PROC QRUN reservoir.\",\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"autotune\"\n\t\t\t\t\t],\n\t\t\t\t\t\"indent\": 1\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"NumQubits\",\n\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\"label\": \"Number of qubits:\",\n\t\t\t\t\t\"min\": 4,\n\t\t\t\t\t\"max\": 30,\n\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"quantumlab\"\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"txtQubitsManual\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"Note: Runtime grows exponentially with qubit count. \",\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"quantumlab\"\n\t\t\t\t\t],\n\t\t\t\t\t\"indent\": 1\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"MinQubits\",\n\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\"label\": \"Minimum qubits:\",\n\t\t\t\t\t\"min\": 4,\n\t\t\t\t\t\"max\": 30,\n\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"autotune\"\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"MaxQubits\",\n\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\"label\": \"Maximum qubits:\",\n\t\t\t\t\t\"min\": 4,\n\t\t\t\t\t\"max\": 30,\n\t\t\t\t\t\"integer\": true,\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"autotune\"\n\t\t\t\t\t]\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"txtQubitsAutoQX\",\n\t\t\t\t\t\"type\": \"text\",\n\t\t\t\t\t\"text\": \"PROC HYPERTUNE searches this inclusive qubit range and the final graphs use the selected champion qubit count.\",\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"autotune\"\n\t\t\t\t\t],\n\t\t\t\t\t\"indent\": 1\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"ml_algorithm\",\n\t\t\t\t\t\"type\": \"radiogroup\",\n\t\t\t\t\t\"label\": \"Machine learning algorithm:\",\n\t\t\t\t\t\"items\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"none\",\n\t\t\t\t\t\t\t\"label\": \"None (skip ML comparison)\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"svm\",\n\t\t\t\t\t\t\t\"label\": \"Support vector machine (SVM)\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"logistic regression\",\n\t\t\t\t\t\t\t\"label\": \"Logistic regression\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"log select\",\n\t\t\t\t\t\t\t\"label\": \"Log select\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"grad boost\",\n\t\t\t\t\t\t\t\"label\": \"Gradient boosting\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"value\": \"random forest\",\n\t\t\t\t\t\t\t\"label\": \"Random forest\"\n\t\t\t\t\t\t}\n\t\t\t\t\t],\n\t\t\t\t\t\"visible\": \"\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"id\": \"secSVMParams\",\n\t\t\t\t\t\"type\": \"section\",\n\t\t\t\t\t\"label\": \"Support Vector Machine (SVM) Parameters\",\n\t\t\t\t\t\"open\": true,\n\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\"$ml_algorithm\",\n\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\"svm\"\n\t\t\t\t\t],\n\t\t\t\t\t\"indent\": 1,\n\t\t\t\t\t\"children\": [\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"C_param\",\n\t\t\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\t\t\"label\": \"C (regularization strength):\",\n\t\t\t\t\t\t\t\"min\": 0.0001,\n\t\t\t\t\t\t\t\"max\": 1000000,\n\t\t\t\t\t\t\t\"integer\": false,\n\t\t\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\t\t\"quantumlab\"\n\t\t\t\t\t\t\t]\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"K_par\",\n\t\t\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\t\t\"label\": \"Gamma (kernel bandwidth):\",\n\t\t\t\t\t\t\t\"min\": 0.0001,\n\t\t\t\t\t\t\t\"max\": 1000000,\n\t\t\t\t\t\t\t\"integer\": false,\n\t\t\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\t\t\"quantumlab\"\n\t\t\t\t\t\t\t]\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"CMin\",\n\t\t\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t\t\t\t\"label\": \"C minimum:\",\n\t\t\t\t\t\t\t\"min\": 0.0001,\n\t\t\t\t\t\t\t\"max\": 1000000,\n\t\t\t\t\t\t\t\"integer\": false,\n\t\t\t\t\t\t\t\"visible\": [\n\t\t\t\t\t\t\t\t\"$Mode\",\n\t\t\t\t\t\t\t\t\"=\",\n\t\t\t\t\t\t\t\t\"autotune\"\n\t\t\t\t\t\t\t]\n\t\t\t\t\t\t},\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\"id\": \"CMax\",\n\t\t\t\t\t\t\t\"type\": \"numberfield\",\n\t\t\t\t